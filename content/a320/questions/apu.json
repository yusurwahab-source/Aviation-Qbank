  {
    "id": "A320-APU-0001",
    "aircraft": "A320",
    "topic": "APU",
    "subtopic": "General",
    "question": "What does the APU supply to the aircraft?",
    "options": [
      {
        "id": "a",
        "text": "Electrical power only"
      },
      {
        "id": "b",
        "text": "Hydraulic and electrical power"
      },
      {
        "id": "c",
        "text": "Pneumatic and electrical power"
      },
      {
        "id": "d",
        "text": "Thrust in an emergency"
      }
    ],
    "correct": "c",
    "explanation": "It is a small gas turbine in the tail that supplies bleed air and drives a generator.",
