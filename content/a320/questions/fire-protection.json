    "topic": "Fire Protection",
    "subtopic": "Detection",
    "question": "Which areas have fire and overheat detection (as opposed to smoke detection)?",
    "options": [
      {
        "id": "a",
        "text": "The cargo compartments"
      },
      {
        "id": "b",
        "text": "The lavatories"
      },
