  {
    "id": "GNAV-CHT-0001",
    "subjectCode": "GNAV",
    "topic": "07 Chart Principles & Scale",
    "question": "A straight line drawn on a chart measures 4.63 cm and represents 150 NM. The chart scale is:",
    "options": [
      {
        "id": "a",
        "text": "1 : 3 000 000."
      },
      {
        "id": "b",
        "text": "1 : 6 000 000."
      },
      {
        "id": "c",
        "text": "1 : 5 000 000."
      },
      {
        "id": "d",
        "text": "1 : 1 000 000."
      }
    ],
    "correct": "b",
    "explanation": "150 NM = 150 × 185 200 cm = 27 780 000 cm. Scale = 4.63 : 27 780 000 = 1 : 6 000 000.",
    "tags": [
      "chart-principles-scale"
    ],
    "status": "published",
    "version": 1
  },
