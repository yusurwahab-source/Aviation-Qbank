    "version": 1
  },
  {
    "id": "RNAV-WAVE-0003",
    "subjectCode": "RNAV",
    "topic": "Nature of Radio Waves",
    "question": "Electromagnetic radiation (radio waves) is produced when:",
    "options": [
      {
        "id": "a",
        "text": "Direct current passes through a wire"
      },
      {
        "id": "b",
        "text": "High-frequency alternating current passes through a wire"
      },
      {
        "id": "c",
        "text": "Low-frequency alternating current passes through a wire"
      },
      {
        "id": "d",
        "text": "No current passes through the wire"
      }
    ],
    "correct": "b",
    "explanation": "As frequency rises, the magnetic field has not fully collapsed before the reversed field starts to build, so energy travels outward from the wire as electromagnetic radiation.",
