  {
    "id": "RNAV-DME-0005",
    "subjectCode": "RNAV",
    "topic": "15 Distance Measuring Equipment (DME)",
    "subtopic": "Introduction and Frequencies",
    "question": "What is the frequency difference between a DME interrogation and its reply?",
    "options": [
      {
        "id": "a",
        "text": "60 MHz"
      },
      {
        "id": "b",
        "text": "1 MHz"
      },
      {
        "id": "c",
        "text": "50 MHz"
      },
      {
        "id": "d",
        "text": "63 MHz"
      }
    ],
    "correct": "d",
    "explanation": "The reply is always 63 MHz above or below the interrogation frequency. This also stops an aircraft locking on to reflections of its own pulses.",
    "tags": [
      "dme",
      "frequency"
    ],
    "status": "published",
    "version": 1
  },
  {
    "id": "RNAV-DME-0006",
    "subjectCode": "RNAV",
    "topic": "15 Distance Measuring Equipment (DME)",
    "subtopic": "Introduction and Frequencies",
    "question": "A DME beacon transmits on 962 MHz. On what frequency does it receive?",
    "options": [
      {
        "id": "a",
        "text": "1 030 MHz"
      },
      {
        "id": "b",
        "text": "1 025 MHz"
      },
      {
        "id": "c",
        "text": "899 MHz"
      },
      {
        "id": "d",
        "text": "962 MHz"
      }
    ],
    "correct": "b",
    "explanation": "The difference is 63 MHz. 962 − 63 = 899 MHz is below the DME band, so the interrogation must be 962 + 63 = 1 025 MHz.",
    "tags": [
      "dme",
      "frequency",
      "calculation"
    ],
    "status": "published",
    "version": 1
  },
