    "id": "POF-LOAD-0035",
    "subjectCode": "POF",
    "topic": "Aeroplane Loads and Limitations",
    "subtopic": "Load factor",
    "question": "Load factor n is defined as:",
    "options": [
      {
        "id": "a",
        "text": "Lift divided by weight (L/W)"
      },
      {
        "id": "b",
        "text": "Weight divided by lift"
      },
      {
        "id": "c",
        "text": "Thrust divided by drag"
      },
      {
        "id": "d",
        "text": "Speed divided by stall speed"
      }
    ],
    "correct": "a",
    "explanation": "n expresses the aerodynamic force the structure carries in multiples of weight; in level flight n = 1.",
    "tags": ["load-factor", "definitions"],
    "status": "published",
    "version": 1
  },
  {
    "id": "POF-LOAD-0036",
    "subjectCode": "POF",
    "topic": "Aeroplane Loads and Limitations",
    "subtopic": "Load factor",
    "question": "In a symmetric pull-up at 100 m/s on a flight-path radius of 1,000 m (at the bottom of the arc), the load factor is:",
    "options": [
      {
        "id": "a",
        "text": "1.02"
      },
      {
        "id": "b",
        "text": "3.02"
      },
      {
        "id": "c",
        "text": "2.02"
      },
      {
        "id": "d",
        "text": "10.2"
      }
    ],
    "correct": "c",
    "explanation": "n = 1 + V²/(g·R) = 1 + 10,000/9,810 = 2.02.",
    "tags": ["pull-up", "load-factor", "calculation"],
    "status": "published",
    "version": 1
  },
  {
    "id": "POF-LOAD-0037",
    "subjectCode": "POF",
    "topic": "Aeroplane Loads and Limitations",
    "subtopic": "Load factor",
    "question": "At 150 m/s, the minimum pull-out radius that keeps n at 2.5 is about:",
    "options": [
      {
        "id": "a",
        "text": "920 m"
      },
      {
        "id": "b",
        "text": "1,530 m"
      },
      {
        "id": "c",
        "text": "610 m"
      },
      {
        "id": "d",
        "text": "2,290 m"
      }
    ],
    "correct": "b",
    "explanation": "R = V²/(g(n − 1)) = 22,500/(9.81 × 1.5) = 1,529 m.",
    "tags": ["pull-out", "calculation"],
    "status": "published",
    "version": 1
  },
