<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>HOLDSHORT — Aviation Trainer</title>
<script src="https://cdn.tailwindcss.com"></script>
<style>
@import url('https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Exo+2:wght@300;400;600;700&display=swap');
:root{
  --bg:#070b0f;--pan:#0c1320;--card:#101824;--bdr:#1a2d45;
  --acc:#00c8ff;--acc2:#ff6b35;--grn:#00e676;--yel:#ffd740;--red:#ff1744;--wht:#e8f4fd;
  --ts:#7a9bb8;--td:#3a5570;
  --TH:50px;--PH:46vh;
  --sit:env(safe-area-inset-top,0px);--sib:env(safe-area-inset-bottom,0px);
}
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
html,body{height:100%;overflow:hidden}
body{background:var(--bg);color:var(--wht);font-family:'Exo 2',sans-serif;
  padding-top:var(--sit);padding-bottom:var(--sib)}
#topbar{height:var(--TH);background:var(--pan);border-bottom:2px solid var(--bdr);
  display:flex;align-items:center;padding:0 12px;gap:10px;flex-shrink:0;z-index:50}
.logo{font-family:'Share Tech Mono',monospace;font-size:16px;color:var(--acc);
  letter-spacing:3px;font-weight:700}
.logo span{color:var(--acc2)}
.sys-tog{display:flex;background:var(--card);border:1px solid var(--bdr);
  border-radius:8px;overflow:hidden;margin-left:auto}
.sb{padding:7px 22px;border:none;background:transparent;color:var(--ts);
  font-family:'Exo 2',sans-serif;font-size:11px;font-weight:700;cursor:pointer;
  text-transform:uppercase;letter-spacing:1px;border-right:1px solid var(--bdr);transition:.15s}
.sb:last-child{border-right:none}
.sb.active{background:var(--acc);color:#000}
#app{display:flex;flex-direction:column;
  height:calc(100vh - var(--TH) - var(--sit) - var(--sib));overflow:hidden}
.sv{display:none;flex:1;flex-direction:column;overflow:hidden}
.sv.active{display:flex}
.map-area{flex:1;position:relative;overflow:hidden;min-height:0}
canvas{display:block;width:100%;height:100%}
.hud{position:absolute;top:8px;left:8px;font-family:'Share Tech Mono',monospace;
  font-size:10px;color:var(--ts);line-height:1.9;pointer-events:none;
  background:rgba(7,11,15,.9);border:1px solid var(--bdr);border-radius:4px;padding:6px 10px}
.hv{color:var(--acc)}
.ipanel{background:var(--pan);border-top:2px solid var(--bdr);
  flex-shrink:0;height:var(--PH);display:flex;flex-direction:column;overflow:hidden}
.ptabs{display:flex;background:var(--bg);border-bottom:1px solid var(--bdr);flex-shrink:0}
.pt{flex:1;padding:8px 3px;border:none;background:transparent;color:var(--td);
  font-family:'Share Tech Mono',monospace;font-size:9px;letter-spacing:.8px;
  text-transform:uppercase;cursor:pointer;border-bottom:2px solid transparent;transition:.15s}
.pt.active{color:var(--acc);border-bottom-color:var(--acc)}
.pp{display:none;flex:1;overflow-y:auto}
.pp.active{display:block}
.iwrap{display:flex;justify-content:center;align-items:center;padding:6px;background:#000;
  height:calc(var(--PH) - 38px)}
.iwrap canvas{max-width:100%;max-height:100%;aspect-ratio:1;width:auto!important;height:auto!important;
  cursor:grab;touch-action:none}
.dgrid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--bdr);
  border:1px solid var(--bdr);border-radius:6px;overflow:hidden;margin:8px}
.dcell{background:var(--card);padding:8px 10px;display:flex;flex-direction:column;gap:2px}
.dlbl{font-family:'Share Tech Mono',monospace;font-size:9px;color:var(--td);letter-spacing:1px}
.dval{font-family:'Share Tech Mono',monospace;font-size:18px;color:var(--acc)}
.dval.g{color:var(--grn)}.dval.y{color:var(--yel)}
</style>
</head>
<body>
<div id="topbar">
  <div class="logo"></div>
  <div class="sys-tog">
    <button class="sb active" onclick="switchSys('vor')">VOR</button>
    <button class="sb"        onclick="switchSys('ndb')">NDB</button>
  </div>
</div>
<div id="app">

<!-- ══ VOR ══ -->
<div id="vor-view" class="sv active">
  <div class="map-area">
    <canvas id="vor-canvas"></canvas>
    <div class="hud">
      HDG <span class="hv" id="v-hdg">000°</span>&emsp;OBS <span class="hv" id="v-obs">360°</span><br>
      RDL <span class="hv" id="v-rdl">000°</span>&emsp;DST <span class="hv" id="v-dst">0.0nm</span><br>
      CDI <span class="hv" id="v-cdi">0.0°</span>&emsp;&ensp;<span class="hv" id="v-tf">TO</span>
    </div>
  </div>
  <div class="ipanel">
    <div class="ptabs">
      <button class="pt active" onclick="sp('v','hsi')">G1000 HSI</button>
      <button class="pt"        onclick="sp('v','data')">DATA</button>
    </div>
    <div class="pp active" id="v-hsi">
      <div class="iwrap"><canvas id="hsi-canvas" width="340" height="340"></canvas></div>
    </div>
    <div class="pp" id="v-data">
      <div class="dgrid">
        <div class="dcell"><div class="dlbl">HEADING</div><div class="dval" id="d-hdg">000°</div></div>
        <div class="dcell"><div class="dlbl">VOR RADIAL</div><div class="dval" id="d-rdl">000°</div></div>
        <div class="dcell"><div class="dlbl">OBS / COURSE</div><div class="dval" id="d-obs">360°</div></div>
        <div class="dcell"><div class="dlbl">CDI DEFLECT</div><div class="dval" id="d-cdi">0.0°</div></div>
        <div class="dcell"><div class="dlbl">TO / FROM</div><div class="dval g" id="d-tf">TO</div></div>
        <div class="dcell"><div class="dlbl">DIST VOR</div><div class="dval" id="d-dst">0.0nm</div></div>
      </div>
    </div>
  </div>
</div>

<!-- ══ NDB ══ -->
<div id="ndb-view" class="sv">
  <div class="map-area">
    <canvas id="ndb-canvas"></canvas>
    <div class="hud">
      HDG <span class="hv" id="n-hdg">000°</span><br>
      ADF <span class="hv" id="n-mb">000°</span>  <span style="color:var(--ts);font-size:9px">→ stn</span><br>
      RB  <span class="hv" id="n-rb">000°</span><br>
      CRS <span style="color:#d400ff;font-family:'Share Tech Mono',monospace" id="n-crs">360°</span>
    </div>
  </div>
  <div class="ipanel">
    <div class="ptabs">
      <button class="pt active" onclick="sp('n','rmi')">RMI</button>
      <button class="pt"        onclick="sp('n','formula')">FORMULA</button>
      <button class="pt"        onclick="sp('n','data')">DATA</button>
    </div>
    <div class="pp active" id="n-rmi">
      <div class="iwrap"><canvas id="rmi-canvas" width="300" height="300"></canvas></div>
    </div>
    <div class="pp" id="n-formula">
      <div style="padding:14px 12px;font-family:'Share Tech Mono',monospace;font-size:10px;color:var(--ts);line-height:2">
        <div style="color:var(--acc);font-size:12px;margin-bottom:8px">HDG + RB = MB (mod 360°)</div>
        <div style="display:flex;gap:10px;align-items:center;justify-content:center;margin:12px 0">
          <div style="text-align:center"><div style="font-size:26px;color:var(--acc)" id="f-hdg">000</div><div style="font-size:9px;color:var(--td)">HEADING</div></div>
          <div style="font-size:20px;color:var(--td)">+</div>
          <div style="text-align:center"><div style="font-size:26px;color:var(--yel)" id="f-rb">000</div><div style="font-size:9px;color:var(--td)">REL BRG</div></div>
          <div style="font-size:20px;color:var(--td)">=</div>
          <div style="text-align:center"><div style="font-size:26px;color:var(--grn)" id="f-mb">000</div><div style="font-size:9px;color:var(--td)">MAG BRG</div></div>
        </div>
        <div style="margin-top:10px;line-height:1.8;color:var(--ts)">
          <span style="color:var(--acc2)">RMI needle HEAD</span> → always points to the NDB station (Magnetic Bearing)<br>
          <span style="color:var(--td)">RMI needle TAIL</span> → shows the radial you are currently ON (bearing FROM station)<br>
          The compass card rotates with aircraft heading — HDG always at top (lubber line)<br>
          Read the needle head directly off the rotating card = Magnetic Bearing to station
        </div>
      </div>
    </div>
    <div class="pp" id="n-data">
      <div class="dgrid">
        <div class="dcell"><div class="dlbl">HEADING</div><div class="dval" id="nd-hdg">000°</div></div>
        <div class="dcell"><div class="dlbl">REL BEARING</div><div class="dval y" id="nd-rb">000°</div></div>
        <div class="dcell"><div class="dlbl">MAG BRG (→ stn)</div><div class="dval g" id="nd-mb">000°</div></div>
        <div class="dcell"><div class="dlbl">RADIAL (tail)</div><div class="dval" id="nd-tail">000°</div></div>
        <div class="dcell" style="grid-column:span 2"><div class="dlbl">DIST NDB</div><div class="dval" id="nd-dst">0.0nm</div></div>
      </div>
    </div>
  </div>
</div>

</div>
<script>
// ═══════════════════════════════════════════════════════════
//  HOLDSHORT — VOR/HSI + NDB/RMI Trainer
//  Based on real G1000 logic
//
//  BEARING convention: 0=N, CW, 0–360°
//  CANVAS angle: 0=E, CW (y-down). Bearing → canvas: d2r(b-90) for POSITIONING
//  Sprite nose-up (tip at (0,-r)): rotate by d2r(bearing) directly
// ═══════════════════════════════════════════════════════════

const S = {
  sys:'vor',
  vor:{ ac:{x:.62,y:.38,hdg:45}, obs:360 },
  ndb:{ ac:{x:.62,y:.38,hdg:200}, crs:360 }
};

// canvas refs
let Vc,Vx, Nc,Nx, Hsi,HsiX, Rmi,RmiX;
const drag={on:false,type:null,sys:null,ox:0,oy:0};
// rotary drag for instruments
const rot={on:false,cv:null,startA:0,startV:0};
let pulse=0;

// ── MATH ──────────────────────────────────────────────────
const d2r=d=>d*Math.PI/180;
const r2d=r=>r*180/Math.PI;
const p3=n=>String(((Math.round(n)%360)+360)%360).padStart(3,'0');
const st=(id,v)=>{const e=document.getElementById(id);if(e)e.textContent=v};
const stC=(id,v,c)=>{const e=document.getElementById(id);if(e){e.textContent=v;e.className='dval '+(c||'')}};

// Bearing A→B (aviation: 0=N, CW)
function brg(ax,ay,bx,by){
  return((r2d(Math.atan2(bx-ax,-(by-ay)))+360)%360);
}

// ── INIT ─────────────────────────────────────────────────
window.addEventListener('DOMContentLoaded',()=>{
  Vc =document.getElementById('vor-canvas'); Vx=Vc.getContext('2d');
  Nc =document.getElementById('ndb-canvas'); Nx=Nc.getContext('2d');
  Hsi=document.getElementById('hsi-canvas'); HsiX=Hsi.getContext('2d');
  Rmi=document.getElementById('rmi-canvas'); RmiX=Rmi.getContext('2d');
  resz();
  window.addEventListener('resize',()=>setTimeout(resz,60));

  // Map canvas drag (aircraft body + nose handle)
  [Vc,Nc].forEach(c=>{
    c.addEventListener('mousedown',mdn);
    c.addEventListener('mousemove',mmv);
    c.addEventListener('mouseup',mup);
    c.addEventListener('mouseleave',mup);
    c.addEventListener('touchstart',e=>{e.preventDefault();ptch(e,'d')},{passive:false});
    c.addEventListener('touchmove', e=>{e.preventDefault();ptch(e,'m')},{passive:false});
    c.addEventListener('touchend',  ()=>mup(),{passive:false});
  });

  // Instrument rotary drag: HSI → VOR OBS,  RMI → NDB course
  [Hsi,Rmi].forEach(c=>{
    c.addEventListener('mousedown', e=>rotStart(e,c));
    c.addEventListener('mousemove', e=>rotMove(e,c));
    c.addEventListener('mouseup',   ()=>rot.on=false);
    c.addEventListener('mouseleave',()=>rot.on=false);
    c.addEventListener('touchstart',e=>{e.preventDefault();rotStart(e.touches[0],c)},{passive:false});
    c.addEventListener('touchmove', e=>{e.preventDefault();rotMove(e.touches[0],c)},{passive:false});
    c.addEventListener('touchend',  ()=>rot.on=false,{passive:false});
  });

  requestAnimationFrame(loop);
});

function resz(){
  [Vc,Nc].forEach(c=>{
    if(c.parentElement){c.width=c.parentElement.clientWidth;c.height=c.parentElement.clientHeight;}
  });
}

// ── UI ───────────────────────────────────────────────────
function switchSys(s){
  S.sys=s;
  document.getElementById('vor-view').classList.toggle('active',s==='vor');
  document.getElementById('ndb-view').classList.toggle('active',s==='ndb');
  document.querySelectorAll('.sb').forEach((b,i)=>b.classList.toggle('active',(i===0&&s==='vor')||(i===1&&s==='ndb')));
  setTimeout(resz,30);
}
function sp(grp,pg){
  const el=document.getElementById(grp+'-'+pg);if(!el)return;
  const panel=el.closest('.ipanel');if(!panel)return;
  panel.querySelectorAll('.pp').forEach(p=>p.classList.remove('active'));
  panel.querySelectorAll('.pt').forEach(t=>t.classList.remove('active'));
  el.classList.add('active');
  panel.querySelectorAll('.pt').forEach(t=>{
    if(t.getAttribute('onclick')&&t.getAttribute('onclick').includes("'"+pg+"'"))t.classList.add('active');
  });
}

// ── ROTARY DRAG (HSI knob) ────────────────────────────────
function rotAngle(e,cv){
  const rect=cv.getBoundingClientRect();
  const logW=cv.getAttribute('width')||cv.clientWidth;
  const logH=cv.getAttribute('height')||cv.clientHeight;
  const sx=(logW/rect.width), sy=(logH/rect.height);
  const lx=((e.clientX||e.pageX)-rect.left)*sx;
  const ly=((e.clientY||e.pageY)-rect.top)*sy;
  return brg(logW/2,logH/2,lx,ly); // bearing from center to finger
}
function rotStart(e,cv){
  rot.on=true;rot.cv=cv;
  rot.startA=rotAngle(e,cv);
  rot.startV=cv===Hsi?S.vor.obs:S.ndb.crs;
}
function rotMove(e,cv){
  if(!rot.on||rot.cv!==cv)return;
  let delta=rotAngle(e,cv)-rot.startA;
  if(delta>180)delta-=360;if(delta<-180)delta+=360;
  const newVal=((Math.round(rot.startV+delta)-1+3600)%360)+1;
  if(cv===Hsi) S.vor.obs=newVal;
  else         S.ndb.crs=newVal;
}

// ── MAP DRAG (aircraft) ───────────────────────────────────
function nosePx(sys,cv){
  const a=sys==='ndb'?S.ndb.ac:S.vor.ac;
  const ax=a.x*cv.width,ay=a.y*cv.height,r=52;
  return{x:ax+Math.sin(d2r(a.hdg))*r,y:ay-Math.cos(d2r(a.hdg))*r};
}
function ptch(e,t){const tt=e.touches[0]||e.changedTouches[0];
  t==='d'?mdn({target:e.target,clientX:tt.clientX,clientY:tt.clientY}):
          mmv({target:e.target,clientX:tt.clientX,clientY:tt.clientY});}
function mdn(e){
  const cv=e.target,sys=cv===Nc?'ndb':'vor';
  const rect=cv.getBoundingClientRect(),mx=e.clientX-rect.left,my=e.clientY-rect.top;
  const a=sys==='ndb'?S.ndb.ac:S.vor.ac;
  const ax=a.x*cv.width,ay=a.y*cv.height;
  const np=nosePx(sys,cv);
  if(Math.hypot(mx-np.x,my-np.y)<28){drag.on=true;drag.type='nose';drag.sys=sys;}
  else if(Math.hypot(mx-ax,my-ay)<36){drag.on=true;drag.type='body';drag.sys=sys;drag.ox=mx-ax;drag.oy=my-ay;}
}
function mmv(e){
  if(!drag.on)return;
  const cv=e.target,rect=cv.getBoundingClientRect(),mx=e.clientX-rect.left,my=e.clientY-rect.top;
  const a=drag.sys==='ndb'?S.ndb.ac:S.vor.ac;
  if(drag.type==='body'){
    a.x=Math.max(.05,Math.min(.95,(mx-drag.ox)/cv.width));
    a.y=Math.max(.05,Math.min(.95,(my-drag.oy)/cv.height));
  } else {
    a.hdg=((r2d(Math.atan2(mx-a.x*cv.width,-(my-a.y*cv.height)))+360)%360);
  }
}
function mup(){drag.on=false;}

// ── SHARED DRAW UTILS ─────────────────────────────────────
function grid(ctx,W,H){
  ctx.strokeStyle='rgba(26,45,69,.25)';ctx.lineWidth=.5;
  for(let x=0;x<W;x+=40){ctx.beginPath();ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.stroke();}
  for(let y=0;y<H;y+=40){ctx.beginPath();ctx.moveTo(0,y);ctx.lineTo(W,y);ctx.stroke();}
}

function compassRose(ctx,cx,cy,R,orange){
  const c=orange?'rgba(255,107,53,':'rgba(0,200,255,';
  ctx.strokeStyle=c+'0.15)';ctx.lineWidth=1;
  ctx.beginPath();ctx.arc(cx,cy,R,0,Math.PI*2);ctx.stroke();
  for(let b=0;b<360;b+=5){
    const a=d2r(b-90),r0=R-2,ri=b%30===0?r0-16:(b%10===0?r0-9:r0-5);
    ctx.strokeStyle=b%90===0?'#c8ddf0':(b%30===0?'#5a7a98':'#2a4a68');
    ctx.lineWidth=b%90===0?2:(b%10===0?1.5:1);
    ctx.beginPath();ctx.moveTo(cx+Math.cos(a)*r0,cy+Math.sin(a)*r0);
    ctx.lineTo(cx+Math.cos(a)*ri,cy+Math.sin(a)*ri);ctx.stroke();
  }
  [{l:'N',b:0},{l:'E',b:90},{l:'S',b:180},{l:'W',b:270}].forEach(({l,b})=>{
    const a=d2r(b-90);
    ctx.fillStyle='#e8f4fd';ctx.font='bold 13px Share Tech Mono';
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText(l,cx+Math.cos(a)*(R-24),cy+Math.sin(a)*(R-24));
  });
}

function vorStn(ctx,cx,cy){
  ctx.save();ctx.translate(cx,cy);
  ctx.strokeStyle='#00c8ff';ctx.fillStyle='rgba(0,200,255,.12)';ctx.lineWidth=2;
  ctx.beginPath();
  for(let i=0;i<6;i++){const a=d2r(i*60-90);i===0?ctx.moveTo(Math.cos(a)*13,Math.sin(a)*13):ctx.lineTo(Math.cos(a)*13,Math.sin(a)*13);}
  ctx.closePath();ctx.fill();ctx.stroke();
  ctx.strokeStyle='#00c8ff';ctx.lineWidth=1.5;
  ctx.beginPath();ctx.moveTo(-5,0);ctx.lineTo(5,0);ctx.stroke();
  ctx.beginPath();ctx.moveTo(0,-5);ctx.lineTo(0,5);ctx.stroke();
  ctx.fillStyle='#00c8ff';ctx.font='bold 9px Share Tech Mono';ctx.textAlign='center';ctx.textBaseline='top';
  ctx.fillText('VOR',0,15);ctx.restore();
}

function ndbStn(ctx,cx,cy){
  ctx.save();ctx.translate(cx,cy);
  ctx.fillStyle='rgba(255,107,53,.2)';ctx.strokeStyle='#ff6b35';ctx.lineWidth=2;
  ctx.beginPath();ctx.moveTo(0,-13);ctx.lineTo(13,0);ctx.lineTo(0,13);ctx.lineTo(-13,0);ctx.closePath();ctx.fill();ctx.stroke();
  ctx.fillStyle='#ff6b35';ctx.font='bold 9px Share Tech Mono';ctx.textAlign='center';ctx.textBaseline='top';
  ctx.fillText('NDB',0,15);ctx.restore();
}

function drawAC(ctx,ax,ay,hdg){
  ctx.save();ctx.translate(ax,ay);ctx.rotate(d2r(hdg));
  ctx.fillStyle='rgba(0,0,0,.4)';ctx.beginPath();ctx.arc(2,2,13,0,Math.PI*2);ctx.fill();
  ctx.fillStyle='#e8f4fd';ctx.strokeStyle='#080c10';ctx.lineWidth=1;
  ctx.beginPath();ctx.moveTo(0,-17);ctx.bezierCurveTo(5,-11,5,0,3,9);ctx.lineTo(-3,9);ctx.bezierCurveTo(-5,0,-5,-11,0,-17);ctx.closePath();ctx.fill();ctx.stroke();
  ctx.beginPath();ctx.moveTo(-3,-1);ctx.lineTo(-20,5);ctx.lineTo(-18,9);ctx.lineTo(-2,4);ctx.closePath();ctx.fill();ctx.stroke();
  ctx.beginPath();ctx.moveTo(3,-1);ctx.lineTo(20,5);ctx.lineTo(18,9);ctx.lineTo(2,4);ctx.closePath();ctx.fill();ctx.stroke();
  ctx.restore();
}

function noseHnd(ctx,ax,ay,hdg){
  const r=52,nx=ax+Math.sin(d2r(hdg))*r,ny=ay-Math.cos(d2r(hdg))*r;
  ctx.strokeStyle='rgba(255,215,64,.4)';ctx.lineWidth=1;ctx.setLineDash([3,3]);
  ctx.beginPath();ctx.moveTo(ax,ay);ctx.lineTo(nx,ny);ctx.stroke();ctx.setLineDash([]);
  ctx.fillStyle='#ffd740';ctx.strokeStyle='#000';ctx.lineWidth=1.5;
  ctx.beginPath();ctx.arc(nx,ny,10,0,Math.PI*2);ctx.fill();ctx.stroke();
  ctx.fillStyle='#000';ctx.font='bold 7px Share Tech Mono';ctx.textAlign='center';ctx.textBaseline='middle';
  ctx.fillText('HDG',nx,ny);
}

// ── CDI CALCULATION ──────────────────────────────────────
//  Returns {cdiDeg, toFrom, rdl}
//  cdiDeg: + = course is to the RIGHT of aircraft (fly right to intercept)
//          - = course is to the LEFT
//  The CDI needle deflects OPPOSITE to cdiDeg: fly TOWARD needle
function calcCDI(acX,acY,cvW,cvH){
  const cx=cvW*.5,cy=cvH*.5;
  const obs=S.vor.obs;
  // Radial = bearing FROM station TO aircraft
  const rdl=brg(cx,cy,acX,acY);
  // Course unit vector (direction of OBS course in canvas)
  const cUx=Math.sin(d2r(obs)), cUy=-Math.cos(d2r(obs));
  // Vector from station to aircraft
  const dX=acX-cx, dY=acY-cy, dist=Math.hypot(dX,dY);
  // Dot product: positive = aircraft is in front of station along course = FROM side
  const dot=cUx*dX+cUy*dY;
  const toFrom=dot<=0?'TO':'FROM';
  // Cross product = lateral deviation (positive = aircraft right of course)
  const cross=cUx*dY-cUy*dX;
  const sinErr=dist>1?cross/dist:0;
  let cdiDeg=r2d(Math.asin(Math.max(-1,Math.min(1,sinErr))));
  // For FROM, reverse CDI — HSI always gives correct sensing
  if(toFrom==='FROM')cdiDeg=-cdiDeg;
  return{cdiDeg:Math.max(-10,Math.min(10,cdiDeg)),toFrom,rdl,dist};
}

// ── VOR MAP ───────────────────────────────────────────────
function drawVOR(){
  const cv=Vc,ctx=Vx,W=cv.width,H=cv.height,cx=W*.5,cy=H*.5;
  const R=Math.min(W,H)*.37;
  ctx.clearRect(0,0,W,H);grid(ctx,W,H);
  compassRose(ctx,cx,cy,R,false);
  vorStn(ctx,cx,cy);
  const a=S.vor.ac,ax=a.x*W,ay=a.y*H,obs=S.vor.obs;

  // OBS course line on map — bearing obs → canvas angle = d2r(obs-90)
  // sin(obs-90)=cos(obs) for x, -cos(obs-90)=sin(obs) for... cleaner: use sin/cos of bearing
  const sinOBS=Math.sin(d2r(obs)), cosOBS=Math.cos(d2r(obs));
  ctx.setLineDash([8,5]);ctx.strokeStyle='rgba(0,200,255,.5)';ctx.lineWidth=1.5;
  ctx.beginPath();
  ctx.moveTo(cx - sinOBS*R*1.1, cy + cosOBS*R*1.1);  // FROM side
  ctx.lineTo(cx + sinOBS*R*1.1, cy - cosOBS*R*1.1);  // TO side
  ctx.stroke();ctx.setLineDash([]);
  // Arrow on TO side
  ctx.save();
  ctx.translate(cx + sinOBS*R*.88, cy - cosOBS*R*.88);
  ctx.rotate(d2r(obs-90));  // canvas angle for this bearing
  ctx.fillStyle='#00c8ff';
  ctx.beginPath();ctx.moveTo(0,-9);ctx.lineTo(5,5);ctx.lineTo(-5,5);ctx.closePath();ctx.fill();
  ctx.restore();

  // Radial line (amber) station → aircraft
  ctx.strokeStyle='rgba(255,179,0,.55)';ctx.lineWidth=1.5;
  ctx.beginPath();ctx.moveTo(cx,cy);ctx.lineTo(ax,ay);ctx.stroke();

  drawAC(ctx,ax,ay,a.hdg);
  noseHnd(ctx,ax,ay,a.hdg);

  const{cdiDeg,toFrom,rdl,dist}=calcCDI(ax,ay,W,H);
  const nm=(dist/Math.min(W,H))*50;
  st('v-hdg',p3(a.hdg)+'°');st('v-obs',p3(obs)+'°');st('v-rdl',p3(rdl)+'°');
  st('v-dst',nm.toFixed(1)+'nm');st('v-cdi',cdiDeg.toFixed(1)+'°');st('v-tf',toFrom);
  st('d-hdg',p3(a.hdg)+'°');st('d-rdl',p3(rdl)+'°');st('d-obs',p3(obs)+'°');
  st('d-cdi',cdiDeg.toFixed(1)+'°');
  stC('d-tf',toFrom,toFrom==='TO'?'g':'y');st('d-dst',nm.toFixed(1)+'nm');
  return{cdiDeg,toFrom};
}

// ── G1000 HSI (correct real-world logic) ─────────────────
//
//  Layout:
//  • Compass card rotates opposite to HDG → HDG always under lubber line
//  • Course pointer (cyan diamond + line) set by OBS, rotates WITH card
//    (i.e. stays at fixed world bearing = OBS)
//  • CDI needle: vertical green bar, deflects L/R of course pointer center
//    - centered  = on course
//    - right      = fly right to get on course  (or: course is to the right)
//    - "fly to needle" always gives correct guidance (no reverse sensing)
//  • TO flag (triangle above center) = station ahead on this course
//  • FROM flag (triangle below center) = station behind on this course
//  • Bearing pointer (single white arrow) = ALWAYS points directly to VOR station
//    (like RMI pointer for VOR)
//  • Drag outer rim to rotate OBS/course
//
function drawHSI(){
  const ctx=HsiX,W=340,H=340,cx=170,cy=170,R=152;
  ctx.clearRect(0,0,W,H);
  const a=S.vor.ac,obs=S.vor.obs;
  const{cdiDeg,toFrom}=calcCDI(a.x*Vc.width,a.y*Vc.height,Vc.width,Vc.height);
  // Bearing from aircraft to VOR station (for bearing pointer)
  const toStnBrg=brg(a.x*Vc.width,a.y*Vc.height,Vc.width*.5,Vc.height*.5);

  // ── Outer bezel ──
  ctx.fillStyle='#050c14';ctx.beginPath();ctx.arc(cx,cy,R,0,Math.PI*2);ctx.fill();
  ctx.strokeStyle='#253850';ctx.lineWidth=3;ctx.beginPath();ctx.arc(cx,cy,R,0,Math.PI*2);ctx.stroke();
  // Drag hint ring
  ctx.strokeStyle='rgba(0,200,255,.1)';ctx.lineWidth=12;ctx.beginPath();ctx.arc(cx,cy,R-4,0,Math.PI*2);ctx.stroke();

  // ── Rotating compass card (rotates by -HDG so HDG stays at top) ──
  ctx.save();ctx.translate(cx,cy);ctx.rotate(-d2r(a.hdg));

  // Card background
  ctx.fillStyle='#09131d';ctx.beginPath();ctx.arc(0,0,R-3,0,Math.PI*2);ctx.fill();

  // Tick marks
  for(let b=0;b<360;b+=5){
    const ra=d2r(b-90);
    const r0=R-4,r1=b%30===0?r0-17:(b%10===0?r0-11:r0-6);
    ctx.strokeStyle=b%90===0?'#fff':(b%30===0?'#c0d8f0':'#3a5a80');
    ctx.lineWidth=b%30===0?2.5:(b%10===0?1.5:1);
    ctx.beginPath();ctx.moveTo(Math.cos(ra)*r0,Math.sin(ra)*r0);ctx.lineTo(Math.cos(ra)*r1,Math.sin(ra)*r1);ctx.stroke();
  }
  // Labels at every 30°: N, 3, 6, E, 12, 15, S, 21, 24, W, 30, 33
  ['N','3','6','E','12','15','S','21','24','W','30','33'].forEach((lbl,i)=>{
    const ra=d2r(i*30-90);
    const big=['N','E','S','W'].includes(lbl);
    ctx.fillStyle=big?'#ffffff':'#90b8d8';
    ctx.font=(big?'bold 14px':'10px')+' Share Tech Mono';
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText(lbl,Math.cos(ra)*(R-30),Math.sin(ra)*(R-30));
  });

  // ── Course pointer (cyan) — INSIDE card, pinned to card at bearing obs ──
  // Pointer sprite is nose-up (tip at (0,-R)). Default = bearing 0 (North).
  // To point at bearing obs on card: rotate(d2r(obs)) ← NOT obs-90
  // Card labels use d2r(b-90) for POSITIONING points, but pointer is a rotated sprite.
  ctx.save();ctx.rotate(d2r(obs));
  ctx.strokeStyle='#00c8ff';ctx.lineWidth=2;ctx.setLineDash([6,5]);
  ctx.beginPath();ctx.moveTo(0,-(R-4));ctx.lineTo(0,R-4);ctx.stroke();ctx.setLineDash([]);
  ctx.fillStyle='#00c8ff';
  // TO head: diamond arrowhead
  ctx.beginPath();ctx.moveTo(0,-(R-6));ctx.lineTo(9,-(R-22));ctx.lineTo(0,-(R-14));ctx.lineTo(-9,-(R-22));ctx.closePath();ctx.fill();
  // FROM tail: notched
  ctx.beginPath();ctx.moveTo(0,R-6);ctx.lineTo(-8,R-22);ctx.lineTo(0,R-14);ctx.lineTo(8,R-22);ctx.closePath();ctx.fill();
  ctx.restore(); // end course pointer

  ctx.restore(); // end compass card rotation

  // ── Inner face (fixed) ──
  ctx.fillStyle='#060f18';ctx.beginPath();ctx.arc(cx,cy,R-42,0,Math.PI*2);ctx.fill();
  ctx.strokeStyle='#1a3050';ctx.lineWidth=1;ctx.beginPath();ctx.arc(cx,cy,R-42,0,Math.PI*2);ctx.stroke();

  // ── Lubber line (heading reference, fixed at top) ──
  ctx.fillStyle='#ff6b35';
  ctx.beginPath();ctx.moveTo(cx,cy-R+1);ctx.lineTo(cx-9,cy-R+19);ctx.lineTo(cx+9,cy-R+19);ctx.closePath();ctx.fill();

  // ── CDI scale (5 dots, ±2 dots = ±10°, each dot = 34px) ──
  const dotSp=34;
  [-2,-1,0,1,2].forEach(i=>{
    ctx.beginPath();ctx.arc(cx+i*dotSp,cy,i===0?3:4.5,0,Math.PI*2);
    ctx.fillStyle=i===0?'#2a5070':'rgba(42,80,112,.5)';ctx.fill();
    ctx.strokeStyle='#4a8aaa';ctx.lineWidth=1.5;ctx.stroke();
  });

  // ── CDI needle (green vertical bar) ──
  // deflects in canvas X: positive cdiDeg = fly right = needle to the right
  // "fly to needle" means if needle is right → turn right → that's correct
  const cdiPx=(cdiDeg/10)*dotSp*2;
  const nX=cx+cdiPx;
  // Gradient for depth
  const ng=ctx.createLinearGradient(nX-4,cy-60,nX+4,cy+60);
  ng.addColorStop(0,'#00ff80');ng.addColorStop(.5,'#00e676');ng.addColorStop(1,'#00c060');
  ctx.strokeStyle=ng;ctx.lineWidth=7;ctx.lineCap='round';
  ctx.beginPath();ctx.moveTo(nX,cy-60);ctx.lineTo(nX,cy+60);ctx.stroke();
  ctx.lineCap='butt';

  // ── TO / FROM flag ──
  const tfC=toFrom==='TO'?'#00e676':'#ff6b35';
  ctx.fillStyle=tfC;
  if(toFrom==='TO'){
    // Triangle pointing UP, above center
    ctx.beginPath();ctx.moveTo(cx,cy-76);ctx.lineTo(cx+13,cy-56);ctx.lineTo(cx-13,cy-56);ctx.closePath();ctx.fill();
  } else {
    // Triangle pointing DOWN, below center
    ctx.beginPath();ctx.moveTo(cx,cy+76);ctx.lineTo(cx+13,cy+56);ctx.lineTo(cx-13,cy+56);ctx.closePath();ctx.fill();
  }

  // ── Bearing pointer (single white arrow) ── always points to VOR station
  // World frame: rotate by d2r(toStnBrg) — bearing convention, nose-up sprite
  ctx.save();ctx.translate(cx,cy);ctx.rotate(d2r(toStnBrg));
  // Draw as thin white diamond pointer (single-bar style)
  ctx.strokeStyle='rgba(255,255,255,.7)';ctx.lineWidth=2;
  ctx.beginPath();ctx.moveTo(0,-(R-44));ctx.lineTo(0,R-44);ctx.stroke();
  // Arrow head
  ctx.fillStyle='rgba(255,255,255,.8)';
  ctx.beginPath();ctx.moveTo(0,-(R-44));ctx.lineTo(6,-(R-58));ctx.lineTo(-6,-(R-58));ctx.closePath();ctx.fill();
  // Hollow tail (FROM side)
  ctx.strokeStyle='rgba(255,255,255,.5)';ctx.lineWidth=2;
  ctx.beginPath();ctx.moveTo(0,R-44);ctx.lineTo(-5,R-56);ctx.moveTo(0,R-44);ctx.lineTo(5,R-56);ctx.stroke();
  ctx.restore();

  // ── Aircraft symbol (fixed center) ──
  ctx.strokeStyle='#e8f4fd';ctx.lineWidth=2.5;ctx.lineCap='round';
  // Fuselage
  ctx.beginPath();ctx.moveTo(cx,cy-18);ctx.lineTo(cx,cy+14);ctx.stroke();
  // Wings
  ctx.beginPath();ctx.moveTo(cx-22,cy+2);ctx.lineTo(cx+22,cy+2);ctx.stroke();
  // Tail
  ctx.beginPath();ctx.moveTo(cx-12,cy+12);ctx.lineTo(cx+12,cy+12);ctx.stroke();
  ctx.fillStyle='#e8f4fd';ctx.beginPath();ctx.arc(cx,cy,3,0,Math.PI*2);ctx.fill();
  ctx.lineCap='butt';

  // ── Digital readouts ──
  // HDG box (top)
  ctx.fillStyle='#000';ctx.fillRect(cx-36,cy-R+22,72,22);
  ctx.strokeStyle='#ffffff';ctx.lineWidth=1.5;ctx.strokeRect(cx-36,cy-R+22,72,22);
  ctx.fillStyle='#ffffff';ctx.font='bold 14px Share Tech Mono';
  ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(p3(a.hdg)+'°',cx,cy-R+33);

  // CRS box (bottom-left)
  ctx.fillStyle='#000';ctx.fillRect(6,H-28,80,22);
  ctx.strokeStyle='#00c8ff';ctx.lineWidth=1.5;ctx.strokeRect(6,H-28,80,22);
  ctx.fillStyle='#00c8ff';ctx.font='10px Share Tech Mono';
  ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('CRS '+p3(obs)+'°',46,H-17);

  // TO/FROM box (bottom-right)
  ctx.fillStyle='#000';ctx.fillRect(W-86,H-28,80,22);
  ctx.strokeStyle=tfC;ctx.lineWidth=1.5;ctx.strokeRect(W-86,H-28,80,22);
  ctx.fillStyle=tfC;ctx.font='bold 10px Share Tech Mono';
  ctx.textAlign='center';ctx.textBaseline='middle';
  ctx.fillText(toFrom==='TO'?'▲ TO':'▽ FROM',W-46,H-17);

  // Drag hint text
  ctx.fillStyle='rgba(0,200,255,.3)';ctx.font='8px Share Tech Mono';
  ctx.textAlign='center';ctx.fillText('⟲ drag outer ring to set OBS',cx,H-4);
}

// ── NDB MAP ───────────────────────────────────────────────
function drawNDB(){
  const cv=Nc,ctx=Nx,W=cv.width,H=cv.height,cx=W*.5,cy=H*.5;
  const R=Math.min(W,H)*.36;
  ctx.clearRect(0,0,W,H);grid(ctx,W,H);

  // Pulsing radio waves
  pulse=(pulse+.018)%1;
  [0,.33,.66].forEach(o=>{
    const ph=(pulse+o)%1,r2=ph*R*1.05,al=(1-ph)*.45;
    ctx.strokeStyle=`rgba(255,107,53,${al})`;ctx.lineWidth=1.5;
    ctx.beginPath();ctx.arc(cx,cy,r2,0,Math.PI*2);ctx.stroke();
  });

  ndbStn(ctx,cx,cy);

  // ── Desired track line (magenta dashed) — bearing crs → canvas sin/cos ──
  const sinCRS=Math.sin(d2r(S.ndb.crs)), cosCRS=Math.cos(d2r(S.ndb.crs));
  ctx.setLineDash([8,5]);ctx.strokeStyle='rgba(212,0,255,.6)';ctx.lineWidth=1.5;
  ctx.beginPath();
  ctx.moveTo(cx - sinCRS*R*1.1, cy + cosCRS*R*1.1);
  ctx.lineTo(cx + sinCRS*R*1.1, cy - cosCRS*R*1.1);
  ctx.stroke();ctx.setLineDash([]);
  ctx.save();
  ctx.translate(cx + sinCRS*R*.88, cy - cosCRS*R*.88);
  ctx.rotate(d2r(S.ndb.crs-90));
  ctx.fillStyle='#d400ff';
  ctx.beginPath();ctx.moveTo(0,-9);ctx.lineTo(5,5);ctx.lineTo(-5,5);ctx.closePath();ctx.fill();
  ctx.restore();

  const a=S.ndb.ac,ax=a.x*W,ay=a.y*H;
  // Bearing line station → aircraft
  ctx.strokeStyle='rgba(255,107,53,.45)';ctx.lineWidth=1.5;
  ctx.beginPath();ctx.moveTo(cx,cy);ctx.lineTo(ax,ay);ctx.stroke();

  compassRose(ctx,cx,cy,R,true);
  drawAC(ctx,ax,ay,a.hdg);
  noseHnd(ctx,ax,ay,a.hdg);

  // Bearing FROM aircraft TO station = MB (what needle points at)
  const mb=brg(ax,ay,cx,cy);
  // Relative bearing = MB - HDG
  const rb=((mb-a.hdg)+360)%360;
  // Radial = bearing FROM station TO aircraft = MB + 180
  const radial=(mb+180)%360;
  const dist=(Math.hypot(ax-cx,ay-cy)/Math.min(W,H))*50;

  st('n-hdg',p3(a.hdg)+'°');st('n-mb',p3(mb)+'°');st('n-rb',p3(rb)+'°');st('n-crs',p3(S.ndb.crs)+'°');
  st('nd-hdg',p3(a.hdg)+'°');st('nd-rb',p3(rb)+'°');st('nd-mb',p3(mb)+'°');
  st('nd-tail',p3(radial)+'°');st('nd-dst',dist.toFixed(1)+'nm');
  st('f-hdg',p3(a.hdg));st('f-rb',p3(rb));st('f-mb',p3(mb));
  return{mb,rb,hdg:a.hdg};
}

// ── G1000-style NDB HSI ───────────────────────────────────
//
//  This is the G1000 HSI with NDB bearing pointer (BRG1 = single-line cyan)
//  instead of a CDI needle. Real G1000 behaviour:
//
//  • Same compass card, lubber line, course pointer as VOR HSI
//  • Course pointer (magenta) = desired track, set by drag
//  • NO CDI needle (NDB gives no course deviation)
//  • ADF Bearing Pointer (single thin cyan line) = ALWAYS points to NDB station
//    - head = arrow tip pointing toward station
//    - tail = opposite end (open fork)
//    - drawn as single-bar thin line, rotates in world frame
//  • Bearing info box shows: ADF | MB value
//  • Drag outer ring to set desired course/track
//
function drawRMI(mb,hdg){
  const ctx=RmiX,W=300,H=300,cx=150,cy=150,R=138;
  ctx.clearRect(0,0,W,H);
  const crs=S.ndb.crs;

  // ── Outer bezel ──
  ctx.fillStyle='#050c14';ctx.beginPath();ctx.arc(cx,cy,R,0,Math.PI*2);ctx.fill();
  ctx.strokeStyle='#253850';ctx.lineWidth=3;ctx.beginPath();ctx.arc(cx,cy,R,0,Math.PI*2);ctx.stroke();
  // Drag hint ring (magenta tint for NDB)
  ctx.strokeStyle='rgba(212,0,255,.12)';ctx.lineWidth=12;ctx.beginPath();ctx.arc(cx,cy,R-4,0,Math.PI*2);ctx.stroke();

  // ── Rotating compass card (rotates by -HDG) ──
  ctx.save();ctx.translate(cx,cy);ctx.rotate(-d2r(hdg));

  ctx.fillStyle='#09131d';ctx.beginPath();ctx.arc(0,0,R-3,0,Math.PI*2);ctx.fill();

  for(let b=0;b<360;b+=5){
    const ra=d2r(b-90),r0=R-4,r1=b%30===0?r0-17:(b%10===0?r0-11:r0-6);
    ctx.strokeStyle=b%90===0?'#fff':(b%30===0?'#c0d8f0':'#3a5a80');
    ctx.lineWidth=b%30===0?2.5:(b%10===0?1.5:1);
    ctx.beginPath();ctx.moveTo(Math.cos(ra)*r0,Math.sin(ra)*r0);ctx.lineTo(Math.cos(ra)*r1,Math.sin(ra)*r1);ctx.stroke();
  }
  ['N','3','6','E','12','15','S','21','24','W','30','33'].forEach((lbl,i)=>{
    const ra=d2r(i*30-90),big=['N','E','S','W'].includes(lbl);
    ctx.fillStyle=big?'#fff':'#90b8d8';
    ctx.font=(big?'bold 14px':'10px')+' Share Tech Mono';
    ctx.textAlign='center';ctx.textBaseline='middle';
    ctx.fillText(lbl,Math.cos(ra)*(R-27),Math.sin(ra)*(R-27));
  });

  // ── Course pointer (magenta) — INSIDE card, pinned at bearing crs ──
  // Nose-up sprite → rotate(d2r(crs)), same logic as VOR above ✓
  ctx.save();ctx.rotate(d2r(crs));
  ctx.strokeStyle='#d400ff';ctx.lineWidth=2;ctx.setLineDash([6,5]);
  ctx.beginPath();ctx.moveTo(0,-(R-4));ctx.lineTo(0,R-4);ctx.stroke();ctx.setLineDash([]);
  ctx.fillStyle='#d400ff';
  ctx.beginPath();ctx.moveTo(0,-(R-6));ctx.lineTo(8,-(R-22));ctx.lineTo(0,-(R-14));ctx.lineTo(-8,-(R-22));ctx.closePath();ctx.fill();
  ctx.beginPath();ctx.moveTo(0,R-6);ctx.lineTo(-7,R-20);ctx.lineTo(0,R-13);ctx.lineTo(7,R-20);ctx.closePath();ctx.fill();
  ctx.restore(); // end course pointer

  ctx.restore(); // end card rotation

  // ── Inner face ──
  ctx.fillStyle='#060f18';ctx.beginPath();ctx.arc(cx,cy,R-42,0,Math.PI*2);ctx.fill();
  ctx.strokeStyle='#1a3050';ctx.lineWidth=1;ctx.beginPath();ctx.arc(cx,cy,R-42,0,Math.PI*2);ctx.stroke();

  // ── White ring separating bearing pointer from inner instruments (G1000 style) ──
  ctx.strokeStyle='rgba(255,255,255,.15)';ctx.lineWidth=1.5;
  ctx.beginPath();ctx.arc(cx,cy,R-42,0,Math.PI*2);ctx.stroke();

  // ── Lubber line (orange triangle fixed at top) ──
  ctx.fillStyle='#ff6b35';
  ctx.beginPath();ctx.moveTo(cx,cy-R+1);ctx.lineTo(cx-9,cy-R+19);ctx.lineTo(cx+9,cy-R+19);ctx.closePath();ctx.fill();

  // ── ADF Bearing Pointer — single thin cyan line (BRG1 style) ──
  // In G1000: thin single-bar cyan, head = open arrowhead, tail = open fork
  // Drawn in WORLD frame: rotate by d2r(mb) so head points to station bearing mb
  const bpLen=R-44; // from center to tip
  ctx.save();ctx.translate(cx,cy);ctx.rotate(d2r(mb));

  // Shaft (single thin line, cyan)
  ctx.strokeStyle='#00c8ff';ctx.lineWidth=3;ctx.lineCap='round';
  ctx.beginPath();ctx.moveTo(0,-bpLen);ctx.lineTo(0,bpLen*.52);ctx.stroke();
  ctx.lineCap='butt';

  // HEAD — open arrowhead (G1000 single-bar style: V shape pointing away from shaft)
  ctx.strokeStyle='#00c8ff';ctx.lineWidth=2.5;ctx.lineCap='round';
  ctx.beginPath();ctx.moveTo(-10,-bpLen+18);ctx.lineTo(0,-bpLen);ctx.lineTo(10,-bpLen+18);ctx.stroke();
  // Fill the arrowhead solid for visibility
  ctx.fillStyle='#00c8ff';
  ctx.beginPath();ctx.moveTo(0,-bpLen);ctx.lineTo(9,-bpLen+16);ctx.lineTo(-9,-bpLen+16);ctx.closePath();ctx.fill();

  // TAIL — open fork (G1000 single-bar tail style)
  ctx.strokeStyle='#00c8ff';ctx.lineWidth=2.5;
  ctx.beginPath();ctx.moveTo(0,bpLen*.52);ctx.lineTo(-8,bpLen*.38);ctx.stroke();
  ctx.beginPath();ctx.moveTo(0,bpLen*.52);ctx.lineTo(8,bpLen*.38);ctx.stroke();

  ctx.restore();

  // ── Aircraft symbol (fixed center) ──
  ctx.strokeStyle='#e8f4fd';ctx.lineWidth=2.5;ctx.lineCap='round';
  ctx.beginPath();ctx.moveTo(cx,cy-14);ctx.lineTo(cx,cy+12);ctx.stroke();
  ctx.beginPath();ctx.moveTo(cx-19,cy+2);ctx.lineTo(cx+19,cy+2);ctx.stroke();
  ctx.beginPath();ctx.moveTo(cx-10,cy+10);ctx.lineTo(cx+10,cy+10);ctx.stroke();
  ctx.fillStyle='#e8f4fd';ctx.beginPath();ctx.arc(cx,cy,3,0,Math.PI*2);ctx.fill();
  ctx.lineCap='butt';

  // ── Digital boxes ──
  // HDG box top
  ctx.fillStyle='#000';ctx.fillRect(cx-33,cy-R+20,66,20);
  ctx.strokeStyle='#fff';ctx.lineWidth=1.5;ctx.strokeRect(cx-33,cy-R+20,66,20);
  ctx.fillStyle='#fff';ctx.font='bold 13px Share Tech Mono';
  ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText(p3(hdg)+'°',cx,cy-R+30);

  // CRS box bottom-left (magenta)
  ctx.fillStyle='#000';ctx.fillRect(4,H-26,76,20);
  ctx.strokeStyle='#d400ff';ctx.lineWidth=1.5;ctx.strokeRect(4,H-26,76,20);
  ctx.fillStyle='#d400ff';ctx.font='10px Share Tech Mono';
  ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('CRS '+p3(crs)+'°',42,H-16);

  // ADF/BRG box bottom-right (cyan — shows MB = bearing pointer reading)
  ctx.fillStyle='#000';ctx.fillRect(W-80,H-26,76,20);
  ctx.strokeStyle='#00c8ff';ctx.lineWidth=1.5;ctx.strokeRect(W-80,H-26,76,20);
  ctx.fillStyle='#00c8ff';ctx.font='10px Share Tech Mono';
  ctx.textAlign='center';ctx.textBaseline='middle';ctx.fillText('ADF '+p3(mb)+'°',W-42,H-16);

  // Drag hint
  ctx.fillStyle='rgba(212,0,255,.35)';ctx.font='8px Share Tech Mono';
  ctx.textAlign='center';ctx.fillText('⟲ drag to set desired course',cx,H-3);
}

// ── MAIN LOOP ─────────────────────────────────────────────
function loop(){
  if(S.sys==='vor'){
    drawVOR();
    drawHSI();
  } else {
    const{mb,hdg}=drawNDB()||{mb:0,hdg:0};
    drawRMI(mb,hdg);
  }
  requestAnimationFrame(loop);
}
</script>
