<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>محاكي الطقس - حساب الرياح</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #0f172a;
            color: #f8fafc;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }
        .container {
            background-color: #1e293b;
            padding: 30px;
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            width: 100%;
            max-width: 500px;
        }
        h2 {
            text-align: center;
            color: #38bdf8;
            margin-bottom: 25px;
        }
        .input-group {
            margin-bottom: 15px;
        }
        label {
            display: block;
            margin-bottom: 5px;
            color: #94a3b8;
            font-size: 0.9em;
        }
        input {
            width: 100%;
            padding: 10px;
            border-radius: 8px;
            border: 1px solid #334155;
            background-color: #0f172a;
            color: #fff;
            font-size: 1em;
            box-sizing: border-box;
        }
        input:focus {
            outline: none;
            border-color: #38bdf8;
        }
        .results {
            margin-top: 25px;
            background-color: #0f172a;
            padding: 20px;
            border-radius: 10px;
            border-left: 4px solid #38bdf8;
        }
        .result-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            font-size: 1.1em;
        }
        .result-value {
            font-weight: bold;
            color: #10b981;
        }
        .warning {
            color: #ef4444;
            font-weight: bold;
            text-align: center;
            margin-top: 15px;
            display: none;
        }
    </style>
</head>
<body>

    <div class="container">
        <h2>✈️ محاكي الطقس - الرياح</h2>
        
        <div class="input-group">
            <label>اتجاه المدرج (Runway Heading) بالدرجات:</label>
            <input type="number" id="runwayHdg" placeholder="مثال: 360" min="0" max="360">
        </div>

        <div class="input-group">
            <label>اتجاه الرياح (Wind Direction) بالدرجات:</label>
            <input type="number" id="windDir" placeholder="مثال: 020" min="0" max="360">
        </div>

        <div class="input-group">
            <label>سرعة الرياح (Wind Speed) بالعقد (Knots):</label>
            <input type="number" id="windSpeed" placeholder="مثال: 15" min="0">
        </div>

        <div class="results" id="results" style="display: none;">
            <div class="result-item">
                <span>الرياح الأمامية (Headwind):</span>
                <span class="result-value" id="headwindVal">0 KT</span>
            </div>
            <div class="result-item">
                <span>الرياح الخلفية (Tailwind):</span>
                <span class="result-value" id="tailwindVal">0 KT</span>
            </div>
            <div class="result-item">
                <span>الرياح الجانبية (Crosswind):</span>
                <span class="result-value" id="crosswindVal">0 KT</span>
            </div>
            <div class="result-item">
                <span>اتجاه الرياح الجانبية:</span>
                <span class="result-value" id="crosswindDir">-</span>
            </div>
            <div class="warning" id="warningMsg">⚠️ تحذير: رياح جانبية قوية!</div>
        </div>
    </div>

    <script>
        // دالة لحساب الرياح
        function calculateWind() {
            const rwyHdg = parseFloat(document.getElementById('runwayHdg').value);
            const windDir = parseFloat(document.getElementById('windDir').value);
            const windSpd = parseFloat(document.getElementById('windSpeed').value);

            // التأكد من إدخال جميع البيانات
            if (isNaN(rwyHdg) || isNaN(windDir) || isNaN(windSpd)) {
                document.getElementById('results').style.display = 'none';
                return;
            }

            document.getElementById('results').style.display = 'block';

            // حساب الفرق بين اتجاه الرياح واتجاه المدرج
            let angleDiff = windDir - rwyHdg;
            
            // تحويل الفرق إلى قيمة موجبة (0-180) لحساب المكونات
            // ولكن للاتجاه الجانبي نحتاج لمعرفة ما إذا كانت من اليمين أو اليسار
            let angleRad = angleDiff * (Math.PI / 180);

            // حساب المكونات (باستخدام علم المثلثات)
            // الرياح الأمامية = السرعة * جيب تمام الزاوية
            // الرياح الجانبية = السرعة * جيب الزاوية
            let headwindComponent = windSpd * Math.cos(angleRad);
            let crosswindComponent = windSpd * Math.sin(angleRad);

            // عرض النتائج
            const headwindEl = document.getElementById('headwindVal');
            const tailwindEl = document.getElementById('tailwindVal');
            const crosswindEl = document.getElementById('crosswindVal');
            const crosswindDirEl = document.getElementById('crosswindDir');
            const warningEl = document.getElementById('warningMsg');

            // تصفير القيم
            headwindEl.textContent = '0 KT';
            tailwindEl.textContent = '0 KT';
            crosswindEl.textContent = Math.abs(crosswindComponent).toFixed(1) + ' KT';
            warningEl.style.display = 'none';

            // تحديد ما إذا كانت رياح أمامية أم خلفية
            if (headwindComponent >= 0) {
                headwindEl.textContent = headwindComponent.toFixed(1) + ' KT';
                tailwindEl.textContent = '0 KT';
            } else {
                headwindEl.textContent = '0 KT';
                tailwindEl.textContent = Math.abs(headwindComponent).toFixed(1) + ' KT';
            }

            // تحديد اتجاه الرياح الجانبية (يمين أو يسار)
            if (crosswindComponent > 0) {
                crosswindDirEl.textContent = 'من اليمين (From Right)';
                crosswindDirEl.style.color = '#38bdf8';
            } else if (crosswindComponent < 0) {
                crosswindDirEl.textContent = 'من اليسار (From Left)';
                crosswindDirEl.style.color = '#38bdf8';
            } else {
                crosswindDirEl.textContent = 'لا يوجد';
            }

            // إظهار تحذير إذا كانت الرياح الجانبية أكبر من 15 عقدة
            if (Math.abs(crosswindComponent) > 15) {
                warningEl.style.display = 'block';
            }
        }

        // إضافة مستمعي الأحداث لحساب النتيجة فوراً عند الكتابة
        document.getElementById('runwayHdg').addEventListener('input', calculateWind);
        document.getElementById('windDir').addEventListener('input', calculateWind);
        document.getElementById('windSpeed').addEventListener('input', calculateWind);
    </script>
</body>
</html>